# LLM provider — set one (Anthropic takes priority if both are set)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Email backend: "log" (default, no setup), "mailtrap" (free sandbox), or "gmail"
EMAIL_BACKEND=log
EMAIL_NOTIFICATIONS=true

# Mailtrap — free sandbox at https://mailtrap.io (EMAIL_BACKEND=mailtrap)
MAILTRAP_USER=your_mailtrap_smtp_user
MAILTRAP_PASSWORD=your_mailtrap_smtp_password

# Gmail SMTP (EMAIL_BACKEND=gmail — use an App Password, not your account password)
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_app_password_here

# Gmail OAuth2 inbox polling (set GMAIL_ENABLED=true only when credentials.json is present)
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
GMAIL_ENABLED=false

# App
FRONTEND_URL=http://localhost:3000
